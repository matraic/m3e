{
  "workspaces": [
    "packages/web",
    "packages/react",
    "packages/icons",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "cem": "npm run cem --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "all": "npm run build && npm run cem && npm run lint",
    "clean": "npm run clean --workspaces",
    "clean:coverage": "npm run clean:coverage --workspaces --if-present",
    "release": "npm publish --access public --workspace=@m3e/web --workspace=@m3e/react --workspace=@m3e/mcp",
    "release:icons": "npm publish --access public --workspace=@m3e/icons"
  },
  "type": "module",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.0.0",
    "@wc-toolkit/type-parser": "^1.2.1",
    "babel-plugin-template-html-minifier": "^4.1.0",
    "browserslist": "^4.28.1",
    "custom-element-vs-code-integration": "^1.5.0",
    "eslint": "^10.15.0",
    "monocart-coverage-reports": "^3.2.1",
    "playwright-bdd": "^9.2.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.5",
    "tslib": "^2.8.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "rs-module-lexer@2.8.0": true
  }
}
